{
  "name": "affiliate-automation-erp",
  "version": "0.1.0",
  "private": true,
  "description": "In-house Affiliate Automation & Social Hub \u2014 Next.js 14+ App Router + Supabase",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "verify:schema": "node supabase/ci/verify-schema.mjs",
    "shopee:probe": "tsx scripts/shopee-probe.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "hooks:install": "node scripts/install-hooks.mjs",
    "worker:dev": "pnpm --filter affiliate-worker dev",
    "worker:once": "pnpm --filter affiliate-worker start --once",
    "worker:fixture": "pnpm --filter affiliate-worker once --executor=fixture",
    "worker:warming": "pnpm --filter affiliate-worker start --warming-only",
    "worker:browsers": "pnpm --filter affiliate-worker browsers",
    "db:start": "supabase start",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "import:targets": "tsx scripts/import-targets.ts",
    "demo:e2e": "tsx scripts/demo-e2e.ts",
    "smoke": "tsx scripts/smoke.ts",
    "preflight:prod": "tsx scripts/preflight-prod.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.545.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20.9.0"
  }
}
