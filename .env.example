# --- Supabase -------------------------------------------------------------
# Project URL + anon key are safe to expose to the browser (RLS enforced).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Used by workers / server-to-server calls that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- AI -------------------------------------------------------------------
# Google Gemini API key. Used for post analysis, product matching, drafting.
GEMINI_API_KEY="your-gemini-api-key"
# Generation model for multimodal post analysis + copywriting.
GEMINI_MODEL="gemini-2.5-flash"
# Embedding model. MUST emit 768-dim vectors (see products.embedding vector(768)).
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# --- Automation workers ---------------------------------------------------
# Shared bearer token for the worker-facing API routes under /api/worker/*.
# Generate with: openssl rand -hex 32
WORKER_API_TOKEN="change-me-worker-bearer-token"

# Encrypts account passwords, 2FA secrets and proxy passwords at rest (AES-256-GCM).
# Required before importing accounts: generate with `openssl rand -hex 32`.
# Losing this key makes stored credentials unreadable — re-import the accounts.
ACCOUNT_CREDENTIALS_KEY="change-me-64-hex-chars"

# Minimum AI match probability (0..1) required to enqueue a post for approval.
RADAR_MATCH_THRESHOLD="0.8"

# --- Radar scanning (module 3, first half) --------------------------------
# Turn on the scraper cycle in the worker: it browses each watchlist source that
# is past its scan_interval_mins and hands every post to /api/worker/radar/ingest.
RADAR_ENABLED="false"
# Sources per cycle (a cycle holds one browser profile, so keep it small).
RADAR_SOURCES_PER_CYCLE="3"
# Pin every capture to one product id instead of AI matching. This is the only
# way the radar works before GEMINI_API_KEY is configured.
# RADAR_PINNED_PRODUCT_ID=""
# How long a below-threshold judgement is trusted before the post is scored again.
# 0 disables the cache (useful while tuning RADAR_MATCH_THRESHOLD).
# RADAR_SEEN_TTL_DAYS="30"

# --- Persona warming (module 2) -------------------------------------------
# Turn on the warming cycle in the worker (lifestyle posts + cross-warm comments).
# It posts ordinary content on the accounts' own timelines — no affiliate links.
WARMING_ENABLED="false"
# Timezone the schedules in social_accounts.persona_schedule are written in.
WARMING_TIMEZONE="Asia/Ho_Chi_Minh"
# How late a scheduled slot may still run (so a worker started at noon does not
# replay the whole morning).
WARMING_GRACE_MINUTES="90"
# Retry window after a failed profile_setup (selectors drift while you fix them).
# PROFILE_SETUP_RETRY_MINUTES="30"

# --- Telegram (phone approvals + alerts) ---------------------------------
# Create a bot with @BotFather, then message it once and read the chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN="123456:replace-me"
TELEGRAM_CHAT_ID="replace-me"
# Signs every webhook request. Generate with: openssl rand -hex 32
# Register the webhook with the same value as secret_token.
TELEGRAM_WEBHOOK_SECRET="change-me-telegram-webhook-secret"
# Optional: override the Bot API host. Only used to point the outbound path at a
# local stub during verification.
# TELEGRAM_API_BASE="http://127.0.0.1:8081"

# Public base URL of the dashboard, used in Telegram buttons and links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Scheduled jobs (/api/cron/*) -----------------------------------------
# Bearer token for Vercel Cron / cron-job.org. Falls back to WORKER_API_TOKEN so a
# private VPS needs no extra configuration. Required once the app is public.
# CRON_SECRET="change-me-cron-secret"

# --- Worker only (not read by the app server) -----------------------------
# ANTIDETECT_PROVIDER=gpm|genlogin|local   (local = your own Chrome, no antidetect tool)
# LOCAL_PROFILE_DIR="./.profiles"          one persistent Chrome profile per account
# BROWSER_CHANNEL="chrome"                 empty = Playwright Chromium (containers)
# ASSETS_DIR="./assets"                    <persona>/avatar.* and cover.* for profile_setup
# EVIDENCE_DIR="./.evidence"               screenshots for every executed action
# HEARTBEAT_INTERVAL_MS="60000"
# RADAR_ENABLED / WARMING_ENABLED / DRY_RUN / EXECUTOR=facebook|fixture
