{
  "name": "affiliate-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Execution worker: claims queued comment tasks and publishes them through an antidetect browser.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "fixture": "tsx src/index.ts --once --executor=fixture",
    "typecheck": "tsc --noEmit",
    "browsers": "playwright install chromium",
    "login-check": "tsx src/cli/login-check.ts"
  },
  "dependencies": {
    "playwright": "^1.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
